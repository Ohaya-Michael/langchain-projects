# Backend #1 — plain LangChain chain over LOCAL Chroma stores
#   entrypoint: langchain_chain_rag_function_api.py  (defines `app`)
#   vector DB : ./chroma_immobilien + ./chroma_medicine  (mounted at runtime)
#   embeddings: sentence-transformers/all-MiniLM-L6-v2
#
# Build:  docker build -f Dockerfile.chain_api -t rag-chain-api .
# Run  :  docker run --env-file .env -p 8000:8000 \
#             -v "$PWD/chroma_immobilien:/app/chroma_immobilien:ro" \
#             -v "$PWD/chroma_medicine:/app/chroma_medicine:ro" \
#             -v "$PWD/query_results:/app/query_results" rag-chain-api

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    TOKENIZERS_PARALLELISM=false \
    HF_HOME=/models

WORKDIR /app

# build-essential covers native wheels (chromadb/hnswlib); trim if your platform
# already has prebuilt wheels for everything.
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

# Pre-download the embedding model so the first request isn't slow / needs no network.
RUN python -c "from sentence_transformers import SentenceTransformer as S; \
S('sentence-transformers/all-MiniLM-L6-v2')"

COPY . .

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health').status==200 else 1)"

CMD ["uvicorn", "langchain_chain_rag_function_api:app", "--host", "0.0.0.0", "--port", "8000"]
